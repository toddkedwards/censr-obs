# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/src
!/tools
!/docs
!.clang-format
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md

# Within tools/: keep the harness + fixtures, drop generated output & caches
/tools/out/
__pycache__/
*.pyc

# GPU OCR large binaries — run tools/fetch_gpu_ocr.py to obtain them
/data/models/*.onnx
/third_party/

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber
